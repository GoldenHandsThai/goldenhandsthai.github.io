---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../../public/images/logo.jpg";

const businessName = "Golden Hands Thai Massage";
const businessDescription =
  "Traditional Thai massage studio in Limassol offering Thai bodywork, aroma oil massage, foot reflexology, and easy online booking.";
const bookingUrl =
  "https://www.fresha.com/a/golden-hands-thai-massage-lemesos-limassol-28-october-avenue-331-kn4i5slc";
const mapsUrl = "https://maps.app.goo.gl/aVTwkUDZSiTvtmo27";
const facebookUrl = "https://www.facebook.com/profile.php?id=61588263695559";
const instagramUrl = "https://www.instagram.com/golden.hands.thai.massage/";
const whatsappUrl = "https://wa.me/35796694925";
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const heroImageUrl = `${basePath}images/thai.jpg`;
const siteUrl = Astro.site?.toString().replace(/\/$/, "");
const pageUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : undefined;
const socialImageUrl = siteUrl ? new URL(heroImageUrl, siteUrl).toString() : heroImageUrl;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: businessName,
  description: businessDescription,
  image: socialImageUrl,
  ...(pageUrl ? { url: pageUrl } : {}),
  telephone: "+35796694925",
  email: "goldenhandscyp@gmail.com",
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "28 October Ave 331",
    addressLocality: "Limassol",
    postalCode: "3106",
    addressCountry: "CY",
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday",
      ],
      opens: "10:00",
      closes: "21:00",
    },
  ],
  sameAs: [facebookUrl, instagramUrl],
};

const navItems = [
  { label: "Home", href: "#home" },
  { label: "Treatments", href: "#treatments" },
  { label: "Experience", href: "#experience" },
  { label: "Pricing", href: "#pricing" },
  { label: "Contact", href: "#contact" },
];

const treatments = [
  {
    title: "Traditional Thai Massage",
    time: "60 / 90 min",
    description:
      "Assisted stretches and rhythmic pressure for mobility, posture, and deep release.",
  },
  {
    title: "Aroma Oil Massage",
    time: "60 / 90 min",
    description:
      "Slow flowing work with warm oils for softer recovery and nervous-system reset.",
  },
  {
    title: "Foot Reflexology",
    time: "45 min",
    description:
      "Focused lower-leg and foot treatment for tired feet, circulation, and grounded calm.",
  },
];

const prices = [
  { service: "Back / Head / Face / Foot Massage", duration: "30 min", price: "€40" },
  { service: "Traditional / Oil / Deep Tissue / Aromatherapy / Face and Foot Massage", duration: "1 hr", price: "€60" },
  { service: "Traditional / Oil / Deep Tissue / Aromatherapy / Face and Foot Massage", duration: "1 hr 30 min", price: "€90" },
  { service: "Traditional / Oil / Deep Tissue / Aromatherapy / Face and Foot Massage", duration: "2 hr", price: "€110" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href={`${basePath}images/logo.jpg`} />
    <meta
      name="description"
      content={businessDescription}
    />
    <meta property="og:title" content={businessName} />
    <meta property="og:description" content={businessDescription} />
    <meta property="og:type" content="website" />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={businessName} />
    <meta name="twitter:description" content={businessDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{businessName}</title>
  </head>
  <body class="bg-[#f7f3ea] text-[#1f2a24] antialiased">
    <header
      class="sticky top-0 z-50 border-b border-[#d8ccb7] bg-[#fffaf0]/95 backdrop-blur"
    >
      <div class="section-shell py-2">
        <div class="flex items-center justify-between gap-3">
          <a
            href="#home"
            class="flex min-w-0 items-center gap-2 text-sm font-semibold leading-tight tracking-[0.04em] text-[#234b3a] sm:text-base"
            aria-label="Golden Hands Thai Massage home"
          >
            <Image
              src={logo}
              alt=""
              class="size-8 shrink-0 rounded-full object-cover ring-2 ring-[#d4a34f]"
              width="32"
              height="32"
              loading="eager"
              fetchpriority="high"
            />
            <span>Golden Hands Thai Massage</span>
          </a>

          <button
            type="button"
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border border-[#d8ccb7] text-[#234b3a] transition hover:bg-[#e9dfcc] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4a34f] md:hidden"
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-haspopup="true"
            aria-label="Open navigation menu"
            data-menu-toggle
          >
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              data-menu-icon
            >
              <path d="M4 7h16"></path>
              <path d="M4 12h16"></path>
              <path d="M4 17h16"></path>
            </svg>
            <svg
              class="hidden size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
              data-close-icon
            >
              <path d="M6 6l12 12"></path>
              <path d="M18 6 6 18"></path>
            </svg>
          </button>

          <nav aria-label="Primary navigation" class="hidden gap-1 md:flex">
            {
              navItems.map((item) => (
                <a
                  href={item.href}
                  class="whitespace-nowrap rounded-full px-3 py-1.5 text-sm font-medium text-[#496e5a] transition hover:bg-[#e9dfcc] hover:text-[#1f2a24] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4a34f]"
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>

        <nav
          id="mobile-menu"
          aria-label="Mobile navigation"
          aria-hidden="true"
          class="mt-2 hidden rounded-lg border border-[#d8ccb7] bg-[#fffaf0] p-1.5 shadow-sm md:hidden"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="block rounded-lg px-4 py-2 text-sm font-medium text-[#496e5a] transition hover:bg-[#e9dfcc] hover:text-[#1f2a24] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4a34f]"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <section
        id="home"
        class="scroll-mt-20 bg-cover bg-center"
        style={`background-image: linear-gradient(90deg, rgba(17, 31, 25, 0.82), rgba(17, 31, 25, 0.35)), url('${heroImageUrl}')`}
      >
        <div
          class="section-shell flex min-h-[86svh] items-center py-16 text-[#fffaf0] sm:min-h-[82svh] sm:py-24"
        >
          <div class="max-w-2xl">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.22em] text-[#f7d68b]">
              Thai massage studio
            </p>
            <h1 class="text-4xl font-semibold leading-tight sm:text-6xl">
              Golden Hands Thai Massage
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-8 text-[#f8ead0]">
              A calm one-page studio experience for traditional Thai bodywork,
              aroma oil massage, reflexology, and easy appointment booking.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={bookingUrl}
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#d4a34f] px-6 text-sm font-semibold text-[#1f2a24] transition hover:bg-[#e6ba69] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#fffaf0]"
              >
                Book a session
              </a>
              <a
                href="#treatments"
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#fff0cc] px-6 text-sm font-semibold text-[#fffaf0] transition hover:bg-[#fffaf0] hover:text-[#1f2a24] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#fffaf0]"
              >
                View treatments
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="bg-[#234b3a] py-5 text-[#fffaf0]" aria-label="Studio highlights">
        <div class="section-shell grid gap-3 text-sm sm:grid-cols-3">
          <p>Open daily from 10:00 to 21:00</p>
          <p>Certified Thai bodywork therapists</p>
          <p>Central studio with private treatment rooms</p>
        </div>
      </section>

      <section id="treatments" class="scroll-mt-20 py-16 sm:py-24">
        <div class="section-shell">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#b77a3d]">
              Treatments
            </p>
            <h2 class="mt-3 text-3xl font-semibold text-[#1f2a24] sm:text-4xl">
              Bodywork built around how you feel today
            </h2>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {
              treatments.map((treatment) => (
                <article class="rounded-lg border border-[#d8ccb7] bg-[#fffaf0] p-6 shadow-sm">
                  <div class="mb-6 flex items-center justify-between gap-4">
                    <h3 class="text-xl font-semibold text-[#234b3a]">
                      {treatment.title}
                    </h3>
                    <span class="shrink-0 rounded-full bg-[#e7f0e9] px-3 py-1 text-xs font-semibold text-[#496e5a]">
                      {treatment.time}
                    </span>
                  </div>
                  <p class="leading-7 text-[#52645a]">{treatment.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="experience" class="scroll-mt-20 bg-[#fffaf0] py-16 sm:py-24">
        <div class="section-shell grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#b77a3d]">
              Experience
            </p>
            <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">
              Warm, quiet, and practical from arrival to aftercare
            </h2>
            <p class="mt-5 leading-8 text-[#52645a]">
              Every visit starts with clear arrival details, treatment
              expectations, therapist notes, and an easy path to book from any
              screen size.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div class="rounded-lg bg-[#e7f0e9] p-6">
              <p class="text-3xl font-semibold text-[#234b3a]">01</p>
              <h3 class="mt-4 text-lg font-semibold">Personal intake</h3>
              <p class="mt-2 leading-7 text-[#52645a]">
                Short check-in for pressure, areas to avoid, and treatment goals.
              </p>
            </div>
            <div class="rounded-lg bg-[#f7e6b8] p-6">
              <p class="text-3xl font-semibold text-[#7a4f34]">02</p>
              <h3 class="mt-4 text-lg font-semibold">Balanced pressure</h3>
              <p class="mt-2 leading-7 text-[#5f5141]">
                Clear therapist communication without interrupting the calm flow.
              </p>
            </div>
            <div class="rounded-lg bg-[#efe3d3] p-6 sm:col-span-2">
              <p class="text-3xl font-semibold text-[#b77a3d]">03</p>
              <h3 class="mt-4 text-lg font-semibold">Simple aftercare</h3>
              <p class="mt-2 leading-7 text-[#5f5141]">
                Hydration, mobility tips, and repeat-visit guidance when useful.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="pricing" class="scroll-mt-20 py-16 sm:py-24">
        <div class="section-shell">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div class="max-w-2xl">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#b77a3d]">
                Pricing
              </p>
              <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">
                Clear options for a first booking
              </h2>
            </div>
            <a
              href={bookingUrl}
              class="inline-flex min-h-11 items-center justify-center rounded-full bg-[#234b3a] px-5 text-sm font-semibold text-[#fffaf0] transition hover:bg-[#2f624c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4a34f]"
            >
              Reserve time
            </a>
          </div>

          <div class="mt-10 overflow-hidden rounded-lg border border-[#d8ccb7] bg-[#fffaf0]">
            {
              prices.map((item) => (
                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 border-b border-[#e8ddcb] p-5 last:border-b-0 sm:grid-cols-[1fr_8rem_6rem]">
                  <div class="min-w-0 sm:contents">
                    <p class="font-semibold text-[#234b3a]">{item.service}</p>
                    <p class="mt-1 text-sm text-[#52645a] sm:mt-0">
                      {item.duration}
                    </p>
                  </div>
                  <p class="text-right text-lg font-semibold">{item.price}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="contact" class="scroll-mt-20 bg-[#234b3a] py-16 text-[#fffaf0] sm:py-24">
        <div class="section-shell grid gap-10 lg:grid-cols-[1fr_0.9fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#f7d68b]">
              Contact
            </p>
            <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">
              Ready for a calmer body?
            </h2>
            <p class="mt-5 max-w-xl leading-8 text-[#d8eadc]">
              Book a session, call the studio, or get directions to Golden Hands
              Thai Massage in Limassol.
            </p>
          </div>

          <div class="rounded-lg bg-[#fffaf0] p-6 text-[#1f2a24] shadow-xl">
            <h3 class="text-xl font-semibold text-[#234b3a]">Studio details</h3>
            <dl class="mt-6 grid gap-4 text-sm">
              <div>
                <dt class="font-semibold">Phone</dt>
                <dd class="mt-1 text-[#52645a]">
                  <a href="tel:+35796694925" class="hover:text-[#234b3a]">
                    +357 96 694925
                  </a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold">Address</dt>
                <dd class="mt-1 text-[#52645a]">
                  <a
                    href={mapsUrl}
                    class="inline-flex items-start gap-2 hover:text-[#234b3a]"
                  >
                    <svg
                      class="mt-0.5 size-4 shrink-0 text-[#234b3a]"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M20 10c0 4.99-5.54 10.55-7.4 12.27a.88.88 0 0 1-1.2 0C9.54 20.55 4 14.99 4 10a8 8 0 0 1 16 0Z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>28 October Ave 331, Limassol 3106, Cyprus</span>
                  </a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold">Email</dt>
                <dd class="mt-1 text-[#52645a]">
                  <a
                    href="mailto:goldenhandscyp@gmail.com"
                    class="break-words hover:text-[#234b3a]"
                  >
                    goldenhandscyp@gmail.com
                  </a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold">Hours</dt>
                <dd class="mt-1 text-[#52645a]">Daily, 10:00-21:00</dd>
              </div>
              <div>
                <dt class="font-semibold">Social</dt>
                <dd class="mt-2 flex gap-3">
                  <a
                    href={facebookUrl}
                    class="inline-flex size-10 items-center justify-center rounded-full bg-[#234b3a] text-[#fffaf0] transition hover:bg-[#2f624c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#234b3a]"
                    aria-label="Golden Hands Thai Massage on Facebook"
                  >
                    <svg
                      class="size-5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M14 8.5h2.2V5.1c-.4-.1-1.7-.2-3.1-.2-3.1 0-5.1 1.9-5.1 5.3v3H4.7V17H8v7h4v-7h3.3l.5-3.8H12v-2.6c0-1.1.3-2.1 2-2.1Z"></path>
                    </svg>
                  </a>
                  <a
                    href={instagramUrl}
                    class="inline-flex size-10 items-center justify-center rounded-full bg-[#234b3a] text-[#fffaf0] transition hover:bg-[#2f624c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#234b3a]"
                    aria-label="Golden Hands Thai Massage on Instagram"
                  >
                    <svg
                      class="size-5"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="4" y="4" width="16" height="16" rx="5"></rect>
                      <circle cx="12" cy="12" r="3.5"></circle>
                      <circle cx="16.8" cy="7.2" r="0.7" fill="currentColor" stroke="none"></circle>
                    </svg>
                  </a>
                  <a
                    href={whatsappUrl}
                    class="inline-flex size-10 items-center justify-center rounded-full bg-[#234b3a] text-[#fffaf0] transition hover:bg-[#2f624c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#234b3a]"
                    aria-label="Message Golden Hands Thai Massage on WhatsApp"
                  >
                    <svg
                      class="size-5"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M19.1 4.9A9.8 9.8 0 0 0 3.8 16.7L2.7 21l4.4-1.1A9.8 9.8 0 0 0 19.1 4.9Zm-7 15.1a7.8 7.8 0 0 1-4-1.1l-.3-.2-2.6.7.7-2.5-.2-.3A7.8 7.8 0 1 1 12.1 20Zm4.3-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8.9-.1.2-.3.2-.5.1a6.4 6.4 0 0 1-1.9-1.2 7.4 7.4 0 0 1-1.3-1.7c-.1-.3 0-.4.1-.5l.4-.4c.1-.1.2-.3.3-.4.1-.2 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.9 2.3 1 2.5c.1.2 1.8 2.8 4.4 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.1-.4-.2Z"></path>
                    </svg>
                  </a>
                </dd>
              </div>
            </dl>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              <a
                href="tel:+35796694925"
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#d4a34f] px-6 text-sm font-semibold text-[#1f2a24] transition hover:bg-[#e6ba69] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#234b3a]"
              >
                Call to book
              </a>
              <a
                href={mapsUrl}
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-[#234b3a] px-6 text-sm font-semibold text-[#234b3a] transition hover:bg-[#e7f0e9] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#234b3a]"
              >
                Get directions
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#172a22] py-6 text-sm text-[#c8d8cc]">
      <div class="section-shell flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p>© 2026 Golden Hands Thai Massage</p>
        <a href="#home" class="font-semibold text-[#f7d68b] hover:text-[#fffaf0]">
          Back to top
        </a>
      </div>
    </footer>

    <script is:inline>
      const menuButton = document.querySelector("[data-menu-toggle]");
      const mobileMenu = document.getElementById("mobile-menu");
      const menuIcon = menuButton?.querySelector("[data-menu-icon]");
      const closeIcon = menuButton?.querySelector("[data-close-icon]");

      const setMenuOpen = (isOpen) => {
        menuButton?.setAttribute("aria-expanded", String(isOpen));
        menuButton?.setAttribute(
          "aria-label",
          isOpen ? "Close navigation menu" : "Open navigation menu",
        );
        mobileMenu?.classList.toggle("hidden", !isOpen);
        mobileMenu?.setAttribute("aria-hidden", String(!isOpen));
        menuIcon?.classList.toggle("hidden", isOpen);
        closeIcon?.classList.toggle("hidden", !isOpen);
      };

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        setMenuOpen(!isOpen);
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setMenuOpen(false);
        }
      });
    </script>
  </body>
</html>
